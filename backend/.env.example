# Postgres. Heroku sets DATABASE_URL automatically. Local: `docker compose up -d` at the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/easypay
# Get a key at https://openrouter.ai/keys (leave empty to use the offline parser; voice needs a key)
OPENROUTER_API_KEY=
# Cheap model that understands text AND audio (used for chat, tips and voice transcription)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash-lite
STATIC_DIR=../frontend/dist
# PORT=8080
