# Postgres. Heroku sets DATABASE_URL automatically. Local: `docker compose up -d` at the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/easypay
# Get a key at https://openrouter.ai/keys (leave empty to use the offline parser; voice needs a key)
OPENROUTER_API_KEY=
# Cheap model that understands text AND audio (used for chat, tips and voice transcription)
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_AUDIO_MODEL=google/gemini-2.5-flash-lite
STATIC_DIR=../frontend/dist
# PORT=8080
# Emails allowed into the platform admin panel (/admin), comma-separated
ADMIN_EMAILS=
# Public URL (used for Stripe redirects)
APP_URL=http://localhost:5173
# Real payments (empty = demo mode). See PAYMENTS.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_BPS_BR=150
PLATFORM_FEE_BPS=100
# Per-seller AI calls per minute
AI_REQUESTS_PER_MINUTE=30
DATABASE_POOL_SIZE=5
# Mercado Pago (Brazil)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
# Encrypts sellers' payment tokens
SECRETS_KEY=dev-only-change-me
# Emails via resend.com (empty = printed in logs)
RESEND_API_KEY=
EMAIL_FROM=Easy Pay <onboarding@resend.dev>
