{
  "name": "Easy Pay",
  "description": "Chat with AI to create payment links with itemized receipts (payments mocked).",
  "repository": "https://github.com/chicogborba/easy-pay",
  "keywords": ["rust", "axum", "react", "payments", "openrouter"],
  "stack": "container",
  "formation": {
    "web": { "quantity": 1, "size": "basic" }
  },
  "addons": [
    { "plan": "heroku-postgresql:essential-0" }
  ],
  "env": {
    "OPENROUTER_API_KEY": {
      "description": "OpenRouter API key (https://openrouter.ai/keys). Leave empty to use the offline parser.",
      "required": false
    },
    "OPENROUTER_MODEL": {
      "description": "Model for chat and tips.",
      "value": "google/gemini-2.5-flash"
    },
    "OPENROUTER_AUDIO_MODEL": {
      "description": "Audio-capable model for voice notes.",
      "value": "google/gemini-2.5-flash"
    }
  }
}
