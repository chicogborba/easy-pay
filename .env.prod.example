# Your domain. No domain? Use your VM's public IP with dashes + .sslip.io, e.g. 129-151-10-20.sslip.io
DOMAIN=129-151-10-20.sslip.io
# Any long random password (only used inside the server)
POSTGRES_PASSWORD=change-me-to-something-long
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# chicogborba@gmail.com is always admin. Extra admins for /admin (comma-separated):
ADMIN_EMAILS=
# Long random value (openssl rand -hex 32). Encrypts sellers' payment tokens. Never change it later.
SECRETS_KEY=
# --- Real payments (optional, see PAYMENTS.md). Empty = demo mode. ---
# Brazil: Mercado Pago
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# US and others: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform fee in basis points: 300 = 3% of each payment
PLATFORM_FEE_BPS=0
# Emails (resend.com). Without a key, emails are printed in the app logs.
RESEND_API_KEY=
EMAIL_FROM=Easy Pay <no-reply@yourdomain.com>
