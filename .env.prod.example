# Your domain. No domain? Use your VM's public IP with dashes + .sslip.io, e.g. 129-151-10-20.sslip.io
DOMAIN=129-151-10-20.sslip.io
# Any long random password (only used inside the server)
POSTGRES_PASSWORD=change-me-to-something-long
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Your email here gives you the platform admin panel at /admin (comma-separate several)
ADMIN_EMAILS=you@example.com
# --- Real payments (optional, see STRIPE.md). Empty = demo mode. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform fee in basis points: 300 = 3% of each payment
PLATFORM_FEE_BPS=0
